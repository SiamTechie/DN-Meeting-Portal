rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // User profiles: any signed-in user can read (needed for attendee lookups,
    // room/booking admin views). Users manage their own doc; Admins manage all.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Rooms: readable by any signed-in user, writable only by Admins.
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Bookings: any signed-in user can read/create/update/delete.
    // (No per-booking ownership field exists today, so this mirrors current
    // client behavior. Tighten with an ownerUid field if stricter control is needed.)
    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Mail collection: write-only trigger docs for the Firebase "Trigger Email" extension.
    // Clients should never need to read/update/delete these.
    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
